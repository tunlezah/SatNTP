[Unit]
Description=SatNTP GPS-Disciplined NTP Server Web UI
After=network.target gpsd.service chronyd.service
Wants=gpsd.service

[Service]
Type=simple
User=satntp
Group=satntp
WorkingDirectory=/opt/satntp
ExecStart=/opt/satntp/venv/bin/python -m satntp.app
Restart=always
RestartSec=5
Environment=GPSD_HOST=127.0.0.1
Environment=GPSD_PORT=2947
Environment=CHRONY_POLL_INTERVAL=10

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
